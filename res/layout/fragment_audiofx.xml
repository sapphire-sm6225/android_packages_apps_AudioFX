<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- outside the interceptable layout so it keeps working while effects are off -->
    <TextView
            android:id="@+id/device_chip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/device_chip_background"
            android:clickable="true"
            android:focusable="true"
            android:drawablePadding="8dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="280dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:textColor="@color/preset_chip_text"
            android:textSize="16sp" />

<org.lineageos.audiofx.widget.InterceptableLinearLayout
                android:id="@+id/interceptable_layout"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp">

    <!-- equalizer layout -->
    <FrameLayout class="org.lineageos.audiofx.fragment.EqualizerFragment"
              android:id="@+id/equalizer"
              android:layout_weight="1"
              android:layout_width="match_parent"
              android:layout_height="0dp"/>

    <!-- knobs -->
    <FrameLayout class="org.lineageos.audiofx.fragment.ControlsFragment"
              android:id="@+id/controls"
              android:layout_weight="0"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginStart="16dp"
              android:layout_marginEnd="16dp"
              android:layout_marginBottom="12dp"/>

</org.lineageos.audiofx.widget.InterceptableLinearLayout>

</LinearLayout>
